# Dependencias
node_modules/

# Build
dist/
dist-ssr/
# Build web que se empaqueta en la app nativa (`npm run build:app`).
dist-app/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / SO
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.local
.obsidian/
docs/.obsidian/

# Vite
.vite/

# Variables de entorno — solo se versionan `.env.example` y `.env.test`.
# `.env.test` no contiene secretos: deja las credenciales vacías para que
# las pruebas E2E corran en modo demo y no escriban en el Supabase real.
.env
.env.*
!.env.example
!.env.test

# TypeScript — caché incremental (se regenera con `tsc -b`, no se versiona)
*.tsbuildinfo

# Playwright — artefactos de pruebas E2E
playwright-report/
test-results/
blob-report/

# Estado efímero de la CLI de Supabase local
supabase/.temp/

# Sesiones y artefactos privados de la auditoría manual de la web oficial
# (nunca deben versionarse: pueden contener cookies, tokens o capturas
# con datos personales de la cuenta de prueba)
playwright/.auth/
.auth/
audit-private/
audit-logs-private/
audit-temp/
storageState*.json
*.storage-state.json
*.session.json
