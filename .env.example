# Credenciales de Supabase para el chat de Bananito y el panel /agente.
# Copia este archivo a `.env.local` (que git ignora) y pon los valores reales.
#
# URL del proyecto:   https://<ref>.supabase.co
# anon / public key:  la larga que empieza por eyJ... (Settings → API).
# NO uses la service_role aquí — solo va en servidor, nunca en frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
