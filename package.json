{
  "name": "banana-computer-prototipo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prototipo navegable de la nueva web de Banana Computer (Fase 2). Demostración conceptual con datos de ejemplo.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "build:test": "VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= npm run build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:schema": "vitest run tests/schema",
    "test:rls": "PW_SKIP_WEBSERVER=1 playwright test --project=rls",
    "test:integration": "node scripts/test-supabase-local.mjs",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/e2e/smoke-cross-browser.spec.ts --project=chromium --project=firefox --project=webkit --project=mobile-webkit",
    "test:pwa": "npm run build:test && E2E_CONTRA_BUILD=1 playwright test tests/e2e/pwa.spec.ts --project=chromium",
    "test:e2e:agent": "playwright test --config=playwright.agent.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build:test",
    "check:full": "npm run check && E2E_CONTRA_BUILD=1 npm run test:e2e -- --project=chromium --project=firefox --project=webkit --project=mobile --project=mobile-webkit && npm run test:e2e:agent",
    "icons": "node scripts/generate-icons.mjs",
    "build:app": "tsc -b && vite build --base=/ --outDir=dist-app",
    "app:sync": "npm run build:app && cap sync",
    "app:ios": "npm run app:sync && cap open ios",
    "app:android": "npm run app:sync && cap open android",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "audit:banana:login": "tsx scripts/banana-audit/create-session.ts",
    "audit:banana": "tsx scripts/banana-audit/run-audit.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@supabase/supabase-js": "^2.111.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.4.2",
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "playwright": "^1.62.0",
    "prettier": "3.9.6",
    "supabase": "2.111.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
